  "patterns": [
    { "pattern": "###-###-####", "kept": "###-###-####" },
    { "pattern": "+1 (###) ###-####", "kept": "+1 (###) ###-####" },
    { "pattern": "(###) ###-####", "kept": "(###) ###-####" },
    { "pattern": "1-###-###-####", "kept": "1-###-###-####" },
    { "pattern": "+## ### ### ####", "kept": "+## ### ### ####" },
    { "pattern": "##.##.##.##", "kept": "##.##.##.##" },
    { "pattern": "###/###-####", "kept": "###/###-####" },
    { "pattern": "####", "kept": "####", "note": "four characters and four # are the least" },
    { "pattern": "  ###-####  ", "kept": "###-####", "note": "the spaces at either end are taken off" },
    { "pattern": "+1 (###) ###-#### ####### ####### ######", "kept": "+1 (###) ###-#### ####### ####### ######", "note": "40 characters, the most" },
    { "pattern": "+1 (###) ###-#### ####### ####### #######", "kept": null, "note": "41 characters" },
    { "pattern": "###", "kept": null, "note": "three characters" },
    { "pattern": "# # #", "kept": null, "note": "three #" },
    { "pattern": "1234", "kept": null, "note": "no #" },
    { "pattern": "###-###-##00", "kept": null, "note": "a digit after the first #" },
    { "pattern": "### x ####", "kept": null, "note": "a letter" },
    { "pattern": "###_####", "kept": null, "note": "a mark a pattern does not hold" },
    { "pattern": "###\t####", "kept": null, "note": "a tab, which is no space" },
