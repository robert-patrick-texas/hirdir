    { "format": "email_lower_case", "setting": true, "typed": "KIM.LEE@EXAMPLE.NET", "kept": "kim.lee@example.net" },
    { "format": "email_lower_case", "setting": true, "typed": "john.smith@localhost", "kept": "john.smith@localhost", "note": "any host is taken" },
    { "format": "email_lower_case", "setting": true, "typed": "Åsa.Example@Example.ORG", "kept": "åsa.example@example.org" },
    { "format": "email_lower_case", "setting": true, "typed": "Not An Address", "kept": "not an address", "note": "the format lowers the letters and nothing more: the form of an address is the field's own rule, held after the format" },
    { "format": "email_lower_case", "setting": false, "typed": "John.Smith@Example.COM", "kept": "John.Smith@Example.COM" },
    { "format": "title_case_names", "setting": true, "typed": "mary-jane o'brien", "kept": "Mary-Jane O'Brien", "note": "the first letter of each word, after a space, a hyphen or an apostrophe" },
    { "format": "title_case_names", "setting": true, "typed": "mary-jane o’brien", "kept": "Mary-Jane O’Brien", "note": "the apostrophe of typography, as pasted from a document, as well as '" },
