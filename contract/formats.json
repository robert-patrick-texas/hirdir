{
  "about": "The cases the input formats are held to (P-293, P-322). Each of `cases` is a format, named by its setting, the setting's value, what is typed or pasted, and what is kept: what the server saves for `phone_formats` and `email_lower_case`, and what the web page writes as a person leaves the box or pastes into it, for all three. `title_case_names` is the web page's alone, and only its tests read those cases. `note` says why, where it is not plain. Each of `patterns` is a pattern an Admin gives `phone_formats`, and the pattern as it is kept, or null where it is refused. The server's tests read this file, and so do the web page's.",
  "cases": [
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "5550100123", "kept": "+1 (555) 010-0123", "note": "ten digits, as many as the pattern's #" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "1 555 010 0123", "kept": "+1 (555) 010-0123", "note": "the pattern's leading 1 and ten more: the 1 is written once" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "+1 555 010 0123", "kept": "+1 (555) 010-0123" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "15550100123", "kept": "+1 (555) 010-0123" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "+1 (555) 010-0123", "kept": "+1 (555) 010-0123", "note": "a number in the pattern already is written the same" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "(555) 010-0123", "kept": "+1 (555) 010-0123" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555.010.0123", "kept": "+1 (555) 010-0123" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555/010-0123", "kept": "+1 (555) 010-0123" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": " 5550100123 ", "kept": "+1 (555) 010-0123", "note": "a space is one of the marks a number may hold" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555 0100 x12", "kept": "555 0100 x12", "note": "a letter, of an extension: kept as typed" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "+1 555 010 0123 ext. 12", "kept": "+1 555 010 0123 ext. 12", "note": "a letter: kept as typed" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555 010 0123 #12", "kept": "555 010 0123 #12", "note": "a # is none of the marks a number may hold: kept as typed, so that an extension is never taken for digits of the number" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555 010 0123, 12", "kept": "555 010 0123, 12", "note": "a comma, likewise" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "+1 555 0100", "kept": "+1 555 0100", "note": "eight digits, as the examples' numbers have: no pattern fits, and it is kept as typed" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555010012", "kept": "555010012", "note": "nine digits: no pattern fits" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "25550100123", "kept": "25550100123", "note": "eleven digits that do not begin with the pattern's 1" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "+2 555 010 012", "kept": "+2 555 010 012", "note": "typed with a + and the code 2: ten digits, but a number typed with a + fits only by the pattern's leading digits, so that its code is never put in place of the one typed" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "５５５０１００１２３", "kept": "５５５０１００１２３", "note": "digits that are not 0 to 9 are none of a number's: kept as typed" },
    { "format": "phone_formats", "setting": ["+1 (###) ###-####"], "typed": "555–010–0123", "kept": "555–010–0123", "note": "a dash that is not the hyphen - is none of the marks: kept as typed" },
    { "format": "phone_formats", "setting": ["###-###-####"], "typed": "5550100123", "kept": "555-010-0123" },
    { "format": "phone_formats", "setting": ["###-###-####"], "typed": "(555) 010-0123", "kept": "555-010-0123" },
    { "format": "phone_formats", "setting": ["###-###-####"], "typed": "1 555 010 0123", "kept": "1 555 010 0123", "note": "eleven digits, and the pattern has ten # and no leading digit" },
    { "format": "phone_formats", "setting": ["###-###-####"], "typed": "+1 555 010 0123", "kept": "+1 555 010 0123" },
    { "format": "phone_formats", "setting": ["###-###-####"], "typed": "+2 555 010 012", "kept": "+2 555 010 012", "note": "typed with a +: a pattern with no leading digits that writes no + of its own would drop the code" },
    { "format": "phone_formats", "setting": ["###-####", "+1 (###) ###-####"], "typed": "5550100", "kept": "555-0100", "note": "the patterns are tried in their order" },
    { "format": "phone_formats", "setting": ["###-####", "+1 (###) ###-####"], "typed": "555 010 0123", "kept": "+1 (555) 010-0123", "note": "the first does not fit, the second does" },
    { "format": "phone_formats", "setting": ["###-####", "+1 (###) ###-####"], "typed": "+1 555 0100", "kept": "+1 555 0100" },
    { "format": "phone_formats", "setting": ["(###) ###-####", "###.###.####"], "typed": "555.010.0123", "kept": "(555) 010-0123", "note": "both fit: the first is the one" },
    { "format": "phone_formats", "setting": ["+## ### ### ####"], "typed": "+99 555 010 0123", "kept": "+99 555 010 0123", "note": "a pattern that writes a + of its own and no leading digits takes the code among its #" },
    { "format": "phone_formats", "setting": ["+## ### ### ####"], "typed": "99 555 010 0123", "kept": "+99 555 010 0123" },
    { "format": "phone_formats", "setting": ["+## ### ### ####"], "typed": "555 010 0123", "kept": "555 010 0123" },
    { "format": "phone_formats", "setting": ["1-###-###-####"], "typed": "5550100123", "kept": "1-555-010-0123" },
    { "format": "phone_formats", "setting": ["1-###-###-####"], "typed": "+1 555 010 0123", "kept": "1-555-010-0123", "note": "typed with a +, its code the pattern's leading 1" },
    { "format": "phone_formats", "setting": ["1-###-###-####"], "typed": "1-555-010-0123", "kept": "1-555-010-0123" },
    { "format": "phone_formats", "setting": [], "typed": "5550100123", "kept": "5550100123", "note": "no pattern, as from the start: no number is formatted" },
    { "format": "phone_formats", "setting": [], "typed": "555 0100 x12", "kept": "555 0100 x12" },
