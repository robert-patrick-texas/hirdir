#!/bin/sh
# postinst for hirdir.
#
# On a first install: creates the hirdir user, /var/lib/hirdir and its backup directory,
# compiles the byte-code, creates the signing key, runs the migrations, enables and
# starts the service and the backup timer, and prints what to do next.
#
# On an upgrade, and when the same version is installed again: stops the service, backs
# the database up, runs the migrations and starts the service again. If the migration
# fails, the upgrade stops, the service stays stopped, and the message says where the
# backup is and how to go back to the version that was installed before. A migration
# that fails is undone as a whole. The way back restores the backup all the same, so
# that going back never depends on that.
#
# Both times, once the migrations are done: writes /etc/nginx/snippets/hirdir.conf as
# this version ships it, under the URL prefix that file already has, and on an upgrade
# has nginx reload when the file changed. And brings /etc/hirdir/config.toml up to date:
# written on a first install, and at an upgrade given the settings it does not have
# yet, commented out at their defaults, with nothing that a site set changed.
set -e

STATE=/var/lib/hirdir
PYTHON=/opt/hirdir/venv/bin/python
HIRDIR=/opt/hirdir/venv/bin/hirdir
UNITS="hirdir.service hirdir-backup.timer"
SNIPPET=/etc/nginx/snippets/hirdir.conf

# The nginx snippet that holds the URL prefix is not a conffile, because hirdir-setup
# rewrites the prefix in it and dpkg would then ask about it at an upgrade. It is
# written here instead, by "hirdir-setup --renew": from the snippet this version ships,
# under the prefix the file has, tested with "nginx -t" and put back as it was if nginx
# objects. A snippet that was edited by hand is left alone, and the message says so.
# None of this stops an installation: hirdir runs without nginx.
#
# renew_snippet OLD_VERSION: OLD_VERSION is empty on a first install.
renew_snippet() {
    before=$(cksum "$SNIPPET" 2>/dev/null || true)
    if ! renewed=$(hirdir-setup --renew --no-reload --yes); then
        echo "hirdir: $SNIPPET was left as it was, for the reason given above." >&2
        echo "hirdir: nginx refuses an import of more than 1 MB until it is as this version" >&2
        echo "hirdir: ships it. With the cause put right, run: sudo hirdir-setup --renew" >&2
        return 0
    fi
    # A first install has no site that includes the snippet yet, and nothing to say.
    if [ -z "$1" ] || [ "$before" = "$(cksum "$SNIPPET" 2>/dev/null || true)" ]; then
        return 0
    fi
    reloaded=""
    # deb-systemd-invoke obeys a policy-rc.d, as the units below do.
    if [ -d /run/systemd/system ] && command -v nginx >/dev/null \
        && systemctl --quiet is-active nginx.service && nginx -t >/dev/null 2>&1 \
        && deb-systemd-invoke reload nginx.service >/dev/null 2>&1; then
        reloaded=" nginx was reloaded."
    fi
    echo "hirdir: $(printf '%s\n' "$renewed" | tail -n 1)$reloaded"
}

# The settings file is not a conffile, so that no upgrade stops to ask about it. It is
# written here by "hirdir-setup --settings": the whole file on a first install, and at
# an upgrade only the settings it lacks, each commented out at its default. A file that
# cannot be read as TOML is left alone, and the message says so. hirdir runs with the
# defaults where the file says nothing, so none of this stops an installation.
#
# renew_settings OLD_VERSION: OLD_VERSION is empty on a first install.
renew_settings() {
    if ! brought=$(hirdir-setup --settings --yes); then
        echo "hirdir: /etc/hirdir/config.toml was left as it was, for the reason given above." >&2
        echo "hirdir: With the cause put right, run: sudo hirdir-setup --settings" >&2
        return 0
    fi
    case "$brought" in
        *"Nothing to change"*) ;;
        *) if [ -n "$1" ]; then echo "hirdir: $(printf '%s\n' "$brought" | tail -n 1)"; fi ;;
    esac
}

case "$1" in
    configure)
        if ! getent passwd hirdir >/dev/null; then
            adduser --system --group --home "$STATE" --no-create-home --quiet hirdir
        fi
        # The backup directory too, and here: "hirdir admin backup" makes it when it is
        # missing, with whatever umask it is run under, and run by hand as root that
        # leaves a directory that other users may list.
        install -d -o hirdir -g hirdir -m 0750 "$STATE" "$STATE/backups"

        # The package ships no byte-code. Compile it once here: the service cannot
        # write under /opt, and a command run by root must not leave files there that
        # dpkg does not know. prerm removes what this writes.
        "$PYTHON" -m compileall -q -j 0 /opt/hirdir/python/lib /opt/hirdir/venv/lib \
            >/dev/null 2>&1 || true

        backup=""
        if [ -n "$2" ]; then
            # Nothing may write to the database while its schema changes. systemd reads
            # the unit files this version brought first: asked to stop a service whose
            # unit file changed on disk, it prints a warning into every upgrade.
            if [ -d /run/systemd/system ]; then
                systemctl --system daemon-reload >/dev/null || true
                deb-systemd-invoke stop hirdir.service >/dev/null || true
            fi
            # The SQLite file named by the configuration, when there is one already.
            database=$("$PYTHON" -c 'from hirdir import config
path = config.load().database_path
print(path if path is not None and path.is_file() else "")')
            if [ -n "$database" ]; then
                if ! backup=$(umask 0027 && "$HIRDIR" admin backup); then
                    echo "hirdir: the backup of $database before the upgrade failed." >&2
                    echo "hirdir: nothing was migrated and the service is stopped. Put the" >&2
                    echo "hirdir: cause right, then run: sudo dpkg --configure hirdir" >&2
                    exit 1
                fi
                echo "hirdir: the database as it was before this upgrade is kept at $backup"
            fi
        fi

        # The key that signs session tokens, readable by the hirdir user alone. An
        # existing key is left as it is, so sessions survive an upgrade.
        runuser -u hirdir -- "$PYTHON" -c 'from hirdir import config
from hirdir.auth import tokens
tokens.load_or_create_key(config.load().secret_key_path)'

        # Run as root, hirdir admin carries on as the owner of the state directory.
        # The umask keeps the database from being readable by other users.
        if ! (umask 0027 && "$HIRDIR" admin migrate); then
            echo "hirdir: the migration failed, and the service was not started." >&2
            if [ -n "$backup" ]; then
                echo "hirdir: the database as it was before the upgrade is at $backup" >&2
                echo "hirdir: A migration that fails is undone as a whole. To go back, install the" >&2
                echo "hirdir: package of version $2 again and put that backup in its place:" >&2
                echo "hirdir:     sudo apt install --allow-downgrades ./hirdir_$2_amd64.deb" >&2
                echo "hirdir:     sudo systemctl stop hirdir" >&2
                echo "hirdir:     sudo hirdir admin restore $backup" >&2
                echo "hirdir:     sudo systemctl start hirdir" >&2
            fi
            exit 1
        fi

        # After the migration, so that an upgrade that stops there has changed nothing
        # of nginx's, and the version that was installed before is gone back to as it was.
        renew_snippet "$2"
        renew_settings "$2"
        ;;
    abort-upgrade | abort-remove | abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# Enable the service and the backup timer, and start or restart them, in the way
# dh_installsystemd does: an administrator's "systemctl disable" is remembered, a
# policy-rc.d is obeyed, and nothing is started where systemd is not running.
for unit in $UNITS; do
    deb-systemd-helper unmask "$unit" >/dev/null || true
    if deb-systemd-helper --quiet was-enabled "$unit"; then
        deb-systemd-helper enable "$unit" >/dev/null || true
    else
        deb-systemd-helper update-state "$unit" >/dev/null || true
    fi
done
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    if [ -n "$2" ]; then action=restart; else action=start; fi
    # shellcheck disable=SC2086  # UNITS is a list of unit names.
    deb-systemd-invoke "$action" $UNITS >/dev/null || true
fi

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    cat <<'MSG'

hirdir is installed and listens on 127.0.0.1:8715 (systemctl status hirdir).
Create the first Admin, and note the access code it prints:
    sudo hirdir admin create-user --role admin NAME
Add hirdir to an nginx site that already terminates TLS:
    sudo hirdir-setup

MSG
fi

exit 0
