# The image packaging/package-test.sh installs the package in: Ubuntu 26.04 that boots
# systemd as its init. Nothing of hirdir and no nginx is in it, so the test starts
# from a clean system and installs both with apt.
#
# It is built with no context: docker build - < packaging/container/Dockerfile.systemd
# It needs a privileged container with its own cgroup tree; package-test.sh has the flags.
FROM ubuntu:26.04
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        dbus systemd systemd-sysv \
    && rm -rf /var/lib/apt/lists/*
# Docker's Ubuntu image ships a policy-rc.d that forbids maintainer scripts to start
# services. A real host has none, and the package obeys one, so it is removed here to
# test what happens on a real host.
RUN rm -f /usr/sbin/policy-rc.d
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
